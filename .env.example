# SQLite 檔案位置（Docker 部署時掛成 volume，例如 /data/router.db）
DB_PATH=./data/router.db

# api_key 加密用的對稱金鑰（01-config-management.md 的 api_key 加密方案），
# Gateway 實作時會用到，先留著提醒之後要補
ENCRYPTION_KEY=

# 登入密碼的 session token 簽章金鑰（06-site-auth.md），跟前端
# frontend/.env 的 SITE_SESSION_SECRET 要填「同一個值」——Express 後端跟
# Next.js 前端各自獨立驗證同一顆 session cookie，共用這把金鑰才能兩邊都
# 驗證得過。產生方式跟 ENCRYPTION_KEY 一樣：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SITE_SESSION_SECRET=

# 排程健康檢查的間隔（分鐘），只在啟動時讀一次，改了要重啟才生效。
# 只有 auto_health_check_enabled=true 的 deployment 才會被排程掃到。
HEALTH_CHECK_INTERVAL_MINUTES=30

# 2026-09-19 起：Gateway API Key 的預算重置排程間隔（分鐘）——跟健康檢查
# 排程刻意用獨立的環境變數，不共用 HEALTH_CHECK_INTERVAL_MINUTES（見
# docs/requirements/08-api-key-layer.md）。只掃 budget_reset_day 不是
# null 的 key；沒被呼叫過的 key 靠這個排程，實際驗證時的額度檢查另外走
# requireGatewayKey 的惰性重置，兩者互為備援。
BUDGET_RESET_SCAN_INTERVAL_MINUTES=60

# Gateway 監聽的 port
PORT=8787

# 2026-09-19 起：ROUTER_API_KEY 已經整個拿掉。/admin/* 用上面的
# SITE_SESSION_SECRET（登入密碼 session），/v1/* 改用 Gateway API Key 層
# ——這批 key 存在 api_keys 表裡（雜湊儲存），透過 Web UI 的「API Keys」
# 頁面建立，不是環境變數，見 docs/requirements/08-api-key-layer.md。

# 2026-09-23 起：MCP server（`npm run mcp`，見 docs/requirements/07-mcp-server.md）
# 是獨立的 subprocess，只用到這份 .env 裡的 SITE_SESSION_SECRET（自己簽
# session token 打 /admin/*）跟下面的 BACKEND_URL，不需要 DB_PATH/
# ENCRYPTION_KEY。跑 MCP server 前，Express backend（npm run start）必須
# 已經在跑。

# MCP server 呼叫 /admin/* 的目標網址，沒設定時預設 http://localhost:{PORT}
# ——同一台機器上先跑 npm run start 再跑 npm run mcp 通常不用特別設定這個。
BACKEND_URL=
